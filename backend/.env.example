APP_NAME=VehicleManagement API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=sqlite:///./data/vehiclemanagement.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=vehicle_fleet_control_session
# Local HTTP requires false. Production startup requires true and HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
UPLOAD_DIRECTORY=uploads
MAX_DOCUMENT_SIZE=10485760
MAX_IMAGE_SIZE=8388608
ALLOWED_DOCUMENT_TYPES=application/pdf
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ANTIVIRUS_PROVIDER=none

# Email delivery. Use console or mock locally; switch to smtp in production.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@vehiclefleetcontrol.local
SMTP_FROM_NAME=VehicleFleetControl
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:3000
EMAIL_MAX_ATTEMPTS=4
EMAIL_RETRY_BASE_MINUTES=5

# Dedicated scheduler intervals.
EMAIL_DELIVERY_INTERVAL_MINUTES=1
NOTIFICATION_SCAN_INTERVAL_MINUTES=15
DOCUMENT_SCAN_INTERVAL_HOURS=24
MAINTENANCE_SCAN_INTERVAL_MINUTES=60
OVERDUE_RETURN_SCAN_INTERVAL_MINUTES=15
LOW_STOCK_SCAN_INTERVAL_MINUTES=60
CLAIM_SCAN_INTERVAL_MINUTES=1440
CLAIM_REMINDER_AFTER_DAYS=7

# Local by default. See deploy/backend.env.example for production S3 configuration.
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
ERROR_MONITORING_PROVIDER=none
SENTRY_DSN=

# Required only for webhooks. Generate with cryptography.fernet.Fernet.generate_key().
# Use the same private value in API and scheduler environments; retain it for decryption.
INTEGRATIONS_ENCRYPTION_KEY=
