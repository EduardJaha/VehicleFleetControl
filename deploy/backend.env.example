ENVIRONMENT=production
DEBUG=false
# URL-encode the password. Use the same password stored in app-database-password.
DATABASE_URL=postgresql+psycopg://fleet:REPLACE@database:5432/fleet_production
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CORS_ORIGINS=https://fleet.example.com
FRONTEND_URL=https://fleet.example.com
STORAGE_PROVIDER=s3
# Empty endpoint uses AWS. A MinIO endpoint must have trusted HTTPS in production/staging.
S3_ENDPOINT=
S3_BUCKET=fleet-production-attachments
# Empty access/secret pair uses workload IAM credentials on AWS.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu-central-1
S3_ADDRESSING_STYLE=auto
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE
SMTP_PASSWORD=REPLACE
SMTP_FROM_EMAIL=notifications@fleet.example.com
SMTP_USE_TLS=true
ERROR_MONITORING_PROVIDER=none
SENTRY_DSN=
RELEASE=COMMIT_SHA
WEB_CONCURRENCY=2
