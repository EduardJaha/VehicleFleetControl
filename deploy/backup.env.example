PGHOST=database
PGPORT=5432
PGDATABASE=fleet_production
PGUSER=fleet
PGPASSWORD_FILE=/run/secrets/app_database_password
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=fleet-production-backups
BACKUP_S3_ACCESS_KEY=REPLACE
BACKUP_S3_SECRET_KEY=REPLACE
BACKUP_S3_REGION=eu-central-1
BACKUP_PREFIX=production/postgresql
BACKUP_RETENTION_DAYS=30
# Public age recipient only; keep the private identity off the production host.
BACKUP_AGE_RECIPIENT=age1REPLACE
