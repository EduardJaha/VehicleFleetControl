# Compose interpolation only. Copy to production.env outside source control.
COMPOSE_PROJECT_NAME=fleet-production
BACKEND_IMAGE=ghcr.io/your-organization/vehiclefleetcontrol-backend:COMMIT_SHA
FRONTEND_IMAGE=ghcr.io/your-organization/vehiclefleetcontrol-frontend:COMMIT_SHA
BACKUP_IMAGE=ghcr.io/your-organization/vehiclefleetcontrol-backup:COMMIT_SHA
APP_ENV_FILE=/etc/vehiclefleetcontrol/production/backend.env
BACKUP_ENV_FILE=/etc/vehiclefleetcontrol/production/backup.env
POSTGRES_PASSWORD_FILE=/etc/vehiclefleetcontrol/production/postgres-password
POSTGRES_DB=fleet_production
POSTGRES_USER=fleet_admin
POSTGRES_APP_USER=fleet
APP_DATABASE_PASSWORD_FILE=/etc/vehiclefleetcontrol/production/app-database-password
DOMAIN=fleet.example.com
ACME_EMAIL=operations@example.com
